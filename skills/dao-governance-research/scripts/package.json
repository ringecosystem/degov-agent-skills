{
  "name": "@degov-agent-skills/dao-governance-research-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx degov-client.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm exec tsx degov-client.ts help",
    "test": "tsx --test *.test.ts",
    "prettier": "prettier --ignore-unknown --ignore-path ../../../.prettierignore --ignore-path ../../../.gitignore",
    "format": "pnpm run prettier --write ..",
    "format:check": "pnpm run prettier --check ..",
    "typecheck": "tsc --noEmit",
    "wallet:init": "pnpm exec tsx degov-client.ts wallet init",
    "wallet:address": "pnpm exec tsx degov-client.ts wallet address",
    "wallet:balance": "pnpm exec tsx degov-client.ts wallet balance"
  },
  "dependencies": {
    "@x402/evm": "^2.6.0",
    "@x402/fetch": "^2.6.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
